# ─────────────────────────────────────────────────────────────────────────────
# Binance Futures Trading Bot – Environment Variables Template
# Copy this file to .env and fill in your values before running the bot.
# ─────────────────────────────────────────────────────────────────────────────

# ── Binance API ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Set to "true" to use the Binance Futures Testnet (recommended for testing)
BINANCE_FUTURES_TESTNET=true

# ── Telegram Alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── News API (optional) ────────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Trading Parameters ────────────────────────────────────────────────────────
# Maximum leverage allowed (Binance supports up to 125x)
MAX_LEVERAGE=10

# Default leverage when not specified
DEFAULT_LEVERAGE=5

# Enable automated trading (set to "true" with caution)
AUTO_TRADING=false

# ── Risk Management ───────────────────────────────────────────────────────────
# Maximum portfolio drawdown before halting trading (percent)
MAX_DRAWDOWN=10

# Capital at risk per trade (percent of account balance)
RISK_PER_TRADE=2

# Maximum number of simultaneously open positions
MAX_OPEN_POSITIONS=10

# Default stop-loss distance as a fraction of entry price (e.g. 0.02 = 2%)
DEFAULT_STOP_LOSS=0.02

# Default take-profit distance as a fraction of entry price (e.g. 0.04 = 4%)
DEFAULT_TAKE_PROFIT=0.04

# Default notional trade amount in USDT for auto-reentry and the auto-trading loop
DEFAULT_TRADE_AMOUNT=100

# ── Portfolio ─────────────────────────────────────────────────────────────────
# Number of top USDT pairs to trade when diversifying
TOP_N_SYMBOLS=10

# ── Backtesting ───────────────────────────────────────────────────────────────
BACKTEST_INITIAL_CAPITAL=10000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO
